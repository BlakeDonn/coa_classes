    "modes": [
      {
        "name": "Lithic Lance",
        "claim_ids": [
          "talent:primalist/geomancy:31-83-10-2"
        ],
        "structural_description": "Level 20 PassiveGenerating Earthshaping now has a 20% chance to transform your next Geode Barrage within 8 seconds into Lithic Lance.Lithic LanceLaunch a beam of earthen energy at an enemy, dealing 263 + 80% nature SP Physical damage, generating 20 Rage and 2 stacks of Earthshaping.Scales with modifiers to Geode Barrage."
      },
      {
        "name": "Golem Form",
        "claim_ids": [
          "talent:primalist/geomancy:31-83-4-4"
        ],
        "structural_description": "Transform: into a being made of stone and earth for 20 seconds, increasing your haste by 20% and your Armor by 50%, and allowing you to cast damaging spells while moving."
      },
      {
        "name": "Journey To The Core",
        "claim_ids": [
          "talent:primalist/geomancy:31-83-4-8"
        ],
        "structural_description": "Damage dealt by Seismic Tremor now has a 20% chance to form a crag beneath your target that explodes after 3 seconds.Can only occur once every 3 sec.Crag (Damage)Deals 173 + 35% nature SP Physical Damage to up to 5 enemies within 5 yds and increases the damage they take from your Earthquake by 20% for 5 seconds."
      },
      {
        "name": "Heavy Earth",
        "claim_ids": [
          "talent:primalist/geomancy:31-83-4-9"
        ],
        "structural_description": "Your Terrasurge now consumes all stacks of Earthshaping to refresh the duration of Golem Form and grant you Heavy Earth.Heavy Earth (Proc)Each stack of Earthshaping consumed grants you 5% additional damage dealt with Stoneshard and Geode Barrage as Nature Damage while this is active. Lasts 8 seconds.While active you cannot generate Earthshaping."
      }
    ],
