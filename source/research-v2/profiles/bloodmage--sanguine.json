    "modes": [
      {
        "name": "Transgression",
        "claim_ids": [
          "talent:bloodmage/sanguine:20-26-3-0"
        ],
        "structural_description": "Transform: s your Blood Curse into Transgression.Transgression (Cursed Form)Enter a unique Cursed Form for 30 seconds that does not disable the use of Mortal Form abilities and casts a free Vampiric Fang on your target.While active, direct spell damage triggers a Vampiric Feast, dealing 20% additional Shadow damage to enemies, healing you equal to 50% of the damage dealt."
      },
      {
        "name": "Valanar's Vengeance",
        "claim_ids": [
          "talent:bloodmage/sanguine:20-26-4-1"
        ],
        "structural_description": "Requires Mortal FormLaunch a powerful blood bolt at an enemy, dealing 188 + 127.75% SP Shadow damage.Each stack of Thirst reduces the cast time of this ability and increases its damage."
      },
      {
        "name": "Keleseth's Calamity",
        "claim_ids": [
          "talent:bloodmage/sanguine:20-26-7-5"
        ],
        "structural_description": "Requires Mortal FormBend blood in an area, dealing 177 + 69% shadow SP Shadow damage to enemies.Each stack of Thirst reduces the cast time of this ability and increases its damage."
      },
      {
        "name": "Blood Craving",
        "claim_ids": [
          "talent:bloodmage/sanguine:20-26-1-7"
        ],
        "structural_description": "Requires Mortal FormYou crave blood for 12 seconds, for the duration you cannot be interrupted or silenced, and you regain 5% of your maximum health and 15% of your missing Rage every 2 sec."
      },
      {
        "name": "Sacrificial Rite",
        "claim_ids": [
          "talent:bloodmage/sanguine:20-26-4-9"
        ],
        "structural_description": "Requires Mortal FormInvoke a dark ritual, increasing your haste by 20% for 15 seconds.While active, attackers are afflicted with Cursed Blood. Can only occur once per sec.At the end of the duration, your healing done is increased by 15% and you are healed for 795 + 150% SP over 15 seconds."
      }
    ],
