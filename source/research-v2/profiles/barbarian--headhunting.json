        "claim_ids": [
          "talent:barbarian/headhunting:12-32-7-9"
        ],
        "structural_description": "Quickly unleash 3 Berserker Throws at your target and then fling yourself back a great distance, dealing 125% Ranged Weapon Damage, scaling with modifiers to Berserker Axe."
      }
