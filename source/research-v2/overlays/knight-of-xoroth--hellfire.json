    "identity": {
      "fantasy": "A mounted infernal spellblade fighting beside a Greater Imp, banking Hellfire Embers and turning them into a temporary demon-form barrage.",
      "one_line": "Maintain pet and fire effects, build Embers through Cinderblade and infernal attacks, then enter Hellfire Form when the target count and cooldown package can repay it.",
      "primary_family": "commanders",
      "also_fits": [
        "sequencers"
      ],
