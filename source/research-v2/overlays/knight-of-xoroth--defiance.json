  "set": {
    "identity": {
      "fantasy": "A block-and-retaliation fire tank whose imps, Abyssal and attackers feed Rage into shields, rebukes and unusually strong self-healing.",
      "one_line": "Pull with ranged fire and summons, let blocks and hits generate the engine, then spend Rage on mitigation or repeatable healing while commanding pets and keeping threat spread.",
      "primary_family": "commanders",
      "also_fits": [
        "strategists"
      ],
      "playstyle_tags": [
        "summon-retaliation-tank",
        "block-tank",
        "fire-tank"
      ],
      "claim_ids": [
        "talent:knight-of-xoroth/defiance:17-47-2-4",
