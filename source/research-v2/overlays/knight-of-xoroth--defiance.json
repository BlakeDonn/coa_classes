      ]
    },
    "mechanics": {
      "core_loop": "Establish imp and Abyssal pressure, use block-triggered retaliation for threat, and convert Rage into the heal, shield or mitigation needed for the next damage event.",
      "single_target": "Single-target threat is reported strong; keep the no-cooldown heal and major cooldowns available rather than over-spending Rage.",
      "aoe": "Many attackers generate abundant Rage, enabling repeated healing and easy fire threat once the pack is gathered.",
      "movement_and_target_switching": "Mounted Combat and ranged pet or fire actions give better pickup than a purely stationary block tank.",
      "defense_and_control": "Players report a persistent HoT, a minute heal, a large shield, damage reduction and a nearby-enemy heal that can refill health on large pulls.",
      "group_utility": "Imps, Abyssal, grips, rebukes and group mitigation make the tank more than a passive shield wall.",
      "failure_modes": [
